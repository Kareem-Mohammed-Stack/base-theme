{%- comment -%}
  Product metafield: list of images (list.file_reference)
  Name: Landing Images → usually custom.landing_images
{%- endcomment -%}

{%- liquid
  assign mf_ns = section.settings.metafield_namespace | default: 'custom' | strip
  assign mf_key = section.settings.metafield_key | default: 'landing_images' | strip
  assign mf = product.metafields[mf_ns][mf_key]
  assign images = mf.value
  if images == blank
    assign images = product.metafields.custom.landing_images.value
  endif
-%}

{%- if images != blank -%}
  {%- liquid
    assign cols_m = section.settings.columns_mobile | default: '1' | plus: 0
    assign cols_d = section.settings.columns_desktop | default: 1
    if section.settings.full_width
      assign sizes = '100vw'
    else
      assign sizes = '(min-width: 750px) 1200px, 100vw'
    endif
  -%}

  {%- style -%}
    .landing-images-{{ section.id }} {
      padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
      padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
    }
    @media screen and (min-width: 750px) {
      .landing-images-{{ section.id }} {
        padding-top: {{ section.settings.padding_top }}px;
        padding-bottom: {{ section.settings.padding_bottom }}px;
      }
    }
    .landing-images-{{ section.id }} .landing-images__heading {
      text-align: {{ section.settings.heading_alignment }};
      margin: 0 0 2rem;
    }
    .landing-images-{{ section.id }} .landing-images__grid {
      display: grid;
      grid-template-columns: repeat({{ cols_m }}, minmax(0, 1fr));
      gap: {{ section.settings.gap }}px;
    }
    @media screen and (min-width: 750px) {
      .landing-images-{{ section.id }} .landing-images__grid {
        grid-template-columns: repeat({{ cols_d }}, minmax(0, 1fr));
      }
    }
    .landing-images-{{ section.id }} .landing-images__item {
      border-radius: {{ section.settings.image_radius }}px;
      overflow: hidden;
    }
    .landing-images-{{ section.id }} .landing-images__img {
      display: block;
      width: 100%;
      height: auto;
    }
  {%- endstyle -%}

  <div class="landing-images-{{ section.id }} color-{{ section.settings.color_scheme }} gradient">
    <div class="{% unless section.settings.full_width %}page-width{% endunless %}">
      {%- if section.settings.heading != blank -%}
        <h2 class="landing-images__heading {{ section.settings.heading_size }}">{{ section.settings.heading }}</h2>
      {%- endif -%}

      <div class="landing-images__grid">
        {%- for image in images -%}
          {%- render 'landing-image', image: image, sizes: sizes -%}
        {%- endfor -%}
      </div>
    </div>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Landing images",
  "tag": "section",
  "class": "section",
  "enabled_on": {
    "templates": ["product"]
  },
  "settings": [
    {
      "type": "text",
      "id": "metafield_namespace",
      "label": "Metafield namespace",
      "default": "custom"
    },
    {
      "type": "text",
      "id": "metafield_key",
      "label": "Metafield key",
      "default": "landing_images",
      "info": "Settings → Custom data → Products → Landing Images → Namespace and key"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Heading"
    },
    {
      "type": "select",
      "id": "heading_size",
      "options": [
        { "value": "h2", "label": "Small" },
        { "value": "h1", "label": "Medium" },
        { "value": "h0", "label": "Large" }
      ],
      "default": "h1",
      "label": "Heading size"
    },
    {
      "type": "select",
      "id": "heading_alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "center",
      "label": "Heading alignment"
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "min": 1,
      "max": 4,
      "step": 1,
      "default": 1,
      "label": "Columns on desktop"
    },
    {
      "type": "select",
      "id": "columns_mobile",
      "options": [
        { "value": "1", "label": "1" },
        { "value": "2", "label": "2" }
      ],
      "default": "1",
      "label": "Columns on mobile"
    },
    {
      "type": "range",
      "id": "gap",
      "min": 0,
      "max": 40,
      "step": 4,
      "unit": "px",
      "default": 16,
      "label": "Gap"
    },
    {
      "type": "range",
      "id": "image_radius",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 0,
      "label": "Corner radius"
    },
    {
      "type": "checkbox",
      "id": "full_width",
      "default": true,
      "label": "Full width"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "background-1"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 36,
      "label": "Padding top"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 36,
      "label": "Padding bottom"
    }
  ],
  "presets": [
    {
      "name": "Landing images"
    }
  ]
}
{% endschema %}
