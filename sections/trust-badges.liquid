
{% style %}

  .section-{{ section.id }} {
    border-top: solid {{ section.settings.border_color }} {{ section.settings.border_thickness }}px;
    border-bottom: solid {{ section.settings.border_color }} {{ section.settings.border_thickness }}px;
    margin-top: {{ section.settings.margin_top | times: 0.75 | round: 0 }}px;
    margin-bottom: {{ section.settings.margin_bottom | times: 0.75 | round: 0 }}px;
  }
  
  .section-{{ section.id }}-settings {
    margin: 0 auto;
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
    padding-left: {{ section.settings.padding_horizontal_mobile }}rem;
    padding-right: {{ section.settings.padding_horizontal_mobile }}rem;
  }

  .feature-{{ section.id }} .wrapper-box {
    display: grid;
    grid-template-columns: repeat({{ section.settings.feature_row_mobile }}, 1fr);
    background: linear-gradient(180deg, #FFFFFF 0%, #FAF6F5 100%);
    border: 1px solid #F0E6E8;
    border-radius: {{ section.settings.feature_radius | default: 24 }}px;
    padding: 2.5rem 1.8rem;
    gap: {{ section.settings.feature_gap_mobile | default: 20 }}px;
    box-shadow: 0 10px 30px rgba(200, 16, 46, 0.04);
  }
  
  .feature-{{ section.id }} .box {
    display: flex;
    align-items: center;
    flex-direction: column;
    position: relative;
    text-align: center;
    text-decoration: none;
    padding: 1rem 0.5rem;
    transition: all 0.3s ease;
  }
  
  .feature-{{ section.id }} .box__image {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 58px;
    height: 58px;
    min-width: 58px;
    border-radius: 50%;
    background: #FFFFFF;
    border: 1.5px solid #F3D0D7;
    margin: 0 auto 1.2rem auto;
    padding: 13px;
    transition: all 0.35s cubic-bezier(0.25, 0.8, 0.25, 1);
    box-shadow: 0 4px 14px rgba(200, 16, 46, 0.08);
    color: {{ section.settings.feature_icon_color | default: '#C8102E' }};
  }

  .feature-{{ section.id }} .box:hover .box__image {
    background: {{ section.settings.feature_icon_color | default: '#C8102E' }};
    color: #ffffff;
    transform: translateY(-4px) scale(1.08);
    box-shadow: 0 10px 24px rgba(200, 16, 46, 0.28);
    border-color: {{ section.settings.feature_icon_color | default: '#C8102E' }};
  }

  .feature-{{ section.id }} .box__image svg {
    width: 26px;
    height: 26px;
    display: block;
    stroke: currentColor;
    transition: all 0.3s ease;
  }

  .feature-{{ section.id }} .box__image img {
    height: 100%;
    width: auto;
    object-fit: contain;
  }

  .feature-{{ section.id }} .box__title {
    margin: 0;
    font-size: 1.6rem;
    font-weight: 800;
    color: {{ section.settings.feature_heading_color | default: '#1C1917' }};
    line-height: 1.35;
    letter-spacing: -0.01em;
  }
  
  .feature-{{ section.id }} .box__description {
    margin-top: 0.45rem;
  }

  .feature-{{ section.id }} .box__description * {
    margin: 0;
    font-size: 1.45rem;
    font-weight: 500;
    color: {{ section.settings.feature_text_color | default: '#57534E' }};
    line-height: 1.5;
  }

  @media(min-width: 768px) {

    .section-{{ section.id }} {
      margin-top: {{ section.settings.margin_top }}px;
      margin-bottom: {{ section.settings.margin_bottom }}px;
    }
    
    .section-{{ section.id }}-settings {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
      padding-left: {{ section.settings.padding_horizontal }}rem;
      padding-right: {{ section.settings.padding_horizontal }}rem;
    }

    .feature-{{ section.id }} .wrapper-box {
      grid-template-columns: repeat({{ section.settings.feature_row | default: 4 }}, 1fr);
      padding: 3.5rem 3rem;
      gap: {{ section.settings.feature_gap | default: 24 }}px;
    }

    .feature-{{ section.id }} .box {
      flex: 1 0 auto;
      padding: 0.8rem 1.2rem;
    }
    
    .feature-{{ section.id }} .box__title {
      font-size: 1.65rem;
    }

    .feature-{{ section.id }} .box__description * {
      font-size: 1.45rem;
    }
  }
{% endstyle %}

{% unless section.settings.full_width %}
  <style>
    .section-{{ section.id }}-settings {
      max-width: {{ section.settings.content_width | default: 120 }}rem;
    }
  </style>
{% endunless %}

{% capture svg_example_1 %}
  <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
    <path d="M5 18H3a2 2 0 0 1-2-2V7a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2v9a2 2 0 0 1-2 2h-2"/>
    <path d="M15 9h4l3 4v3a2 2 0 0 1-2 2h-1"/>
    <circle cx="7" cy="18" r="2"/>
    <circle cx="17" cy="18" r="2"/>
  </svg>
{% endcapture %}

{% capture svg_example_2 %}
  <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
    <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
    <path d="m9 12 2 2 4-4"/>
  </svg>
{% endcapture %}

{% capture svg_example_3 %}
  <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
    <path d="M3 12a9 9 0 0 1 9-9 9.75 9.75 0 0 1 6.74 2.74L21 8"/>
    <path d="M21 3v5h-5"/>
    <path d="M21 12a9 9 0 0 1-9 9 9.75 9.75 0 0 1-6.74-2.74L3 16"/>
    <path d="M8 16H3v5"/>
  </svg>
{% endcapture %}

{% capture svg_example_4 %}
  <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
    <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/>
  </svg>
{% endcapture %}

<div class="section-{{ section.id }} feature-{{ section.id }}" style="background-color:{{ section.settings.background_color }}; background-image: {{ section.settings.background_gradient }};">
    <div class="section-{{ section.id }}-settings ">
      <div class="wrapper-box">
          {%- for block in section.blocks -%}
              <{% if block.settings.feature_url != blank %}a href="{{ block.settings.feature_url }}"{% else %}div{% endif %} class="box">
                  {% unless block.settings.hide_image %}
                  <div class="box__image">
                      {%- if block.settings.feature_image != blank -%}
                        <img
                          src="{{ block.settings.feature_image | image_url: width: 120 }}"
                          alt="{{ block.settings.feature_image.alt | default: 'feature-item' | escape }}"
                          width="{{ block.settings.feature_image.width | default: 58 }}"
                          height="{{ block.settings.feature_image.height | default: 58 }}"
                          loading="lazy"
                        >
                      {%- else -%}
                       {% case forloop.index %}
                        {% when 1 %}
                          {{ svg_example_1 }}
                        {% when 2 %}
                          {{ svg_example_2 }}
                        {% when 3 %}
                          {{ svg_example_3 }}
                        {% when 4 %}
                          {{ svg_example_4 }}
                        {% else %}
                          {{ svg_example_1 }}
                        {% endcase %}
                      {%- endif -%}
                  </div>
                  {% endunless %}
                  <div class="box__content-wrapper">
                      <div class="box__title">{{ block.settings.feature_title }}</div>
                      <div class="box__description">{{ block.settings.feature_text }}</div>
                  </div>
              </{% if block.settings.feature_url != blank %}a{% else %}div{% endif %}>
          {%- endfor -%}
      </div>
  </div>
</div>

