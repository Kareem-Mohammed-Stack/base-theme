{%- style -%}
  .footer {
    margin-top: {{ section.settings.margin_top | times: 0.75 | round: 0 }}px;
  }

  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    {% if template.name == 'product' and settings.show_sticky_cart_button %}
    padding-bottom: {{ section.settings.padding_bottom | plus: 150 | times: 0.75 | round: 0 }}px;
    {% else %}
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
    {% endif %}
  }

  @media screen and (min-width: 750px) {
    .footer {
      margin-top: {{ section.settings.margin_top }}px;
    }

    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
     {% if template.name == 'product' and settings.show_sticky_cart_button %}
    padding-bottom: {{ section.settings.padding_bottom | plus: 120 }}px;
    {% else %}
    padding-bottom: {{ section.settings.padding_bottom }}px;
    {% endif %}
    }
  }
  .footer-block__details-content .list-menu__item--link:hover {
    color: #ffd2d2 !important;
    padding-left: 4px;
    transition: all 0.25s ease;
  }

  .footer-block__heading {
    position: relative;
    padding-bottom: 6px;
  }

  .footer-block__heading::before {
    content: '';
    position: absolute;
    bottom: 0;
    left: 0;
    width: 28px;
    height: 2px;
    background: #ffd2d2;
    border-radius: 2px;
  }
  /* Sollora red brand footer */
  .footer {
    background: #8f0000 !important;
    color: #fff8f8 !important;
    border-top: none !important;
    position: relative;
    overflow: hidden;
  }

  .footer::before {
    content: '';
    position: absolute;
    inset: 0 0 auto;
    height: 0.45rem;
    background: #ffb4b4;
  }

  .footer .page-width {
    position: relative;
    z-index: 1;
  }

  .footer__content-top {
    padding-top: 4.5rem;
    padding-bottom: 2.5rem;
  }

  .footer-aura-grid {
    display: grid;
    grid-template-columns: 2.2fr 1fr 1fr 1.6fr;
    gap: 3.5rem;
    align-items: start;
  }

  .footer-aura-brand {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }

  .footer-aura-brand__eyebrow {
    font-size: 1.3rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    color: #ffd2d2;
    text-transform: uppercase;
  }

  .footer-aura-brand__title {
    font-family: 'Playfair Display', Georgia, serif;
    font-size: 2.8rem;
    font-weight: 800;
    color: #FFFFFF;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    line-height: 1.1;
    margin: 0 0 0.75rem 0;
  }

  .footer-aura-brand__desc {
    font-size: 1.55rem;
    color: #ffe3e3;
    line-height: 1.6;
    margin: 0;
    max-width: 340px;
    font-family: var(--font-body-family);
  }

  .footer-aura-social-row {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-top: 1.5rem;
  }

  .footer-aura-social-btn {
    width: 44px;
    height: 44px;
    border-radius: 50%;
    border: 1px solid rgba(255, 255, 255, 0.45);
    display: flex;
    align-items: center;
    justify-content: center;
    color: #FFFFFF;
    text-decoration: none;
    transition: all 0.3s ease;
  }

  .footer-aura-social-btn:hover {
    border-color: #FFFFFF;
    background: #FFFFFF;
    color: #8f0000;
    transform: translateY(-2px);
  }

  .footer-aura-heading {
    font-family: 'Playfair Display', Georgia, serif !important;
    font-size: 1.65rem !important;
    font-weight: 700 !important;
    color: #FFFFFF !important;
    margin-bottom: 1.3rem !important;
    margin-top: 0 !important;
    letter-spacing: 0.02em !important;
  }

  .footer-aura-links {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
  }

  .footer-aura-link {
    color: #ffe3e3;
    font-size: 1.4rem;
    text-decoration: none;
    transition: color 0.25s ease, transform 0.25s ease;
    display: inline-block;
  }

  .footer-aura-link:hover {
    color: #FFFFFF;
    transform: translateX(3px);
  }

  .footer-aura-contact-desc {
    color: #ffe3e3;
    font-size: 1.4rem;
    line-height: 1.5;
    margin: 0 0 0.85rem 0;
  }

  .footer-aura-email {
    color: #ffd2d2;
    font-weight: 700;
    font-size: 1.5rem;
    text-decoration: none;
    display: inline-block;
    margin-bottom: 0.6rem;
    transition: color 0.25s ease;
  }

  .footer-aura-email:hover {
    color: #FFFFFF;
  }

  .footer-aura-hours {
    color: #ffc4c4;
    font-size: 1.35rem;
    margin: 0;
  }

  /* Center Floating Back To Top Divider */
  .footer-aura-divider-wrap {
    position: relative;
    border-top: 1px solid rgba(255, 255, 255, 0.3);
    margin-top: 3.5rem;
    padding-top: 2rem;
    padding-bottom: 2rem;
  }

  .footer-aura-back-top {
    position: absolute;
    top: -24px;
    left: 50%;
    transform: translateX(-50%);
    width: 48px;
    height: 48px;
    border-radius: 50%;
    background: #FFFFFF;
    color: #8f0000;
    border: none;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    box-shadow: 0 4px 18px rgba(0, 0, 0, 0.4);
    transition: transform 0.25s ease, background 0.25s ease;
    z-index: 10;
  }

  .footer-aura-back-top:hover {
    transform: translateX(-50%) translateY(-3px);
    background: #ffd2d2;
    color: #8f0000;
  }

  .footer-aura-bottom {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 1.5rem;
  }

  .footer-aura-copy {
    color: #ffc4c4;
    font-size: 1.4rem;
    margin: 0;
  }

  .footer-aura-copy strong {
    color: #FFFFFF;
  }

  .footer-aura-copy span.powered,
  .footer-aura-copy a.powered {
    color: #ffd2d2;
    font-weight: 700;
    text-decoration: none;
    transition: color 0.25s ease, text-decoration 0.25s ease;
  }

  .footer-aura-copy a.powered:hover {
    color: #ffffff;
    text-decoration: underline;
  }

  @media screen and (max-width: 990px) {
    .footer-aura-grid {
      grid-template-columns: 1fr 1fr;
      gap: 2.5rem;
    }
  }

  @media screen and (max-width: 600px) {
    .footer-aura-grid {
      grid-template-columns: 1fr;
      gap: 2rem;
    }
    .footer-aura-bottom {
      flex-direction: column;
      text-align: center;
    }
  }
{%- endstyle -%}
{% if section.settings.show_collapse %}
  <style>
    @media (max-width: 749px) {
      .grid .footer-block.grid__item {
        margin: 0;
      }
      .grid .footer-block__heading {
        position: relative;
        margin: 0;
        padding: 3.5rem 1.5rem 1.5rem 0;
        cursor: pointer;
      }
      .grid .footer-block__heading::after {
        content: "+";
        position: absolute;
        right: 0;
        top: 50%;
        transform: translateY(-50%);
        width: 20px;
        text-align: center;
        font-size: 2.4rem;
      }
      .grid .footer-block__heading:not(.block-collapsed)::after {
        content: "-";
      }
      .grid .footer-block__heading.block-collapsed + .footer-block__details-content {
        visibility: hidden;
        opacity: 0;
        height: 0;
        margin: 0;
        padding: 0;
        transition: all .2s ease-out;
        overflow: hidden;
      }
      .grid .footer-block__heading + .footer-block__details-content {
        visibility: visible;
        opacity: 1;
        height: auto;
        transition: all .2s ease-out;
        overflow: hidden;
        margin-bottom: 3rem;
      }

    }
  </style>
  <script>
window.addEventListener('DOMContentLoaded', () => {
  const headings = document.querySelectorAll('.grid .footer-block__heading');

  const handleCollapse = (heading) => {
    const content = heading.nextElementSibling;

    if (heading.classList.contains('block-collapsed')) {
      heading.classList.remove('block-collapsed');
      heading.setAttribute('aria-expanded', 'true');
      content.style.display = 'block'; // or any other preferred display property
    } else {
      heading.classList.add('block-collapsed');
      heading.setAttribute('aria-expanded', 'false');
      content.style.display = 'none';
    }
  };

  headings.forEach((heading, index) => {
    heading.classList.add('block-collapsed');
    heading.setAttribute('role', 'button');
    heading.setAttribute('aria-expanded', 'false');
    heading.setAttribute('tabindex', '0');

    const content = heading.nextElementSibling;
    content.setAttribute('id', `footer-block-index-${index}`);
    heading.setAttribute('aria-controls', `footer-block-index-${index}`);

    heading.addEventListener('click', () => {
      handleCollapse(heading);
    });

    heading.addEventListener('keydown', (event) => {
      if (event.key === 'Enter' || event.key === ' ') {
        handleCollapse(heading);
      }
    });
  });
});
  </script>
{% endif %}
<style>
   .footer-block__heading {
