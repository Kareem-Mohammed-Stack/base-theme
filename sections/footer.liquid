</style>

<footer class="footer section-{{ section.id }}-padding">
  <div class="page-width">
    
    <div class="footer-aura-grid">
      <!-- Column 1: Brand Hero -->
      <div class="footer-aura-brand">
        <span class="footer-aura-brand__eyebrow">SOLLORA LUXURY</span>
        <h2 class="footer-aura-brand__title">SOLLORA</h2>
        <p class="footer-aura-brand__desc">Elevating homes with modern luxury design. Designed for effortless warmth, zero electrician wiring, and timeless ambient elegance.</p>
        <div class="footer-aura-social-row">
          <a href="#" class="footer-aura-social-btn" aria-label="Facebook">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M18 2h-3a5 5 0 00-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 011-1h3z"/></svg>
          </a>
          <a href="#" class="footer-aura-social-btn" aria-label="Instagram">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="2" width="20" height="20" rx="5" ry="5"/><path d="M16 11.37A4 4 0 1112.63 8 4 4 0 0116 11.37z"/><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"/></svg>
          </a>
        </div>
      </div>

      <!-- Column 2: Information Links -->
      <div class="footer-aura-col">
        <h3 class="footer-aura-heading">Information</h3>
        <ul class="footer-aura-links">
          <li><a href="/policies/privacy-policy" class="footer-aura-link">Privacy policy</a></li>
          <li><a href="/policies/refund-policy" class="footer-aura-link">Refund policy</a></li>
          <li><a href="/policies/terms-of-service" class="footer-aura-link">Terms of service</a></li>
          <li><a href="/policies/shipping-policy" class="footer-aura-link">Shipping policy</a></li>
          <li><a href="/pages/contact" class="footer-aura-link">Contact information</a></li>
        </ul>
      </div>

      <!-- Column 3: Shop Links -->
      <div class="footer-aura-col">
        <h3 class="footer-aura-heading">Shop</h3>
        <ul class="footer-aura-links">
          <li><a href="{{ routes.root_url }}" class="footer-aura-link">Home</a></li>
          <li><a href="{{ routes.all_products_collection_url }}" class="footer-aura-link">Catalog</a></li>
          <li><a href="/pages/contact" class="footer-aura-link">Contact</a></li>
        </ul>
      </div>

      <!-- Column 4: Contact & Touch -->
      <div class="footer-aura-col">
        <h3 class="footer-aura-heading">Need to Get in Touch?</h3>
        <p class="footer-aura-contact-desc">Have questions about Sollora?</p>
        <a href="mailto:sollorastore@gmail.com" class="footer-aura-email">sollorastore@gmail.com</a>
        <p class="footer-aura-hours">Mon – Sat: 9:00 AM – 6:00 PM</p>
      </div>
    </div>

    <!-- Center Floating Back To Top Button & Bottom Bar -->
    <div class="footer-aura-divider-wrap">
      <button type="button" class="footer-aura-back-top" onclick="window.scrollTo({top: 0, behavior: 'smooth'});" aria-label="Back to top">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="18 15 12 9 6 15"></polyline></svg>
      </button>

      <div class="footer-aura-bottom">
        <p class="footer-aura-copy">© 2026 Sollora • Powered by <a href="https://www.orcaad.com/" target="_blank" rel="noopener noreferrer" class="powered">OrcaAd</a></p>
        <div class="footer-aura-payments">
          {% render 'payment-icons-footer' %}
        </div>
      </div>
    </div>

  </div>
</footer>

