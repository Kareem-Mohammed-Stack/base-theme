{%- comment -%}
  Solora logo from theme assets (assets/logo.svg).
  Aspect ratio from SVG viewBox 283.46 x 283.46 (square).
{%- endcomment -%}
{%- liquid
  assign logo_width = settings.logo_width | default: 112
  if logo_width < 50
    assign logo_width = 50
  endif
  if logo_width > 160
    assign logo_width = 160
  endif
-%}
<div class="header__heading-logo-wrapper solora-logo-wrapper">
  <img
    src="{{ 'logo.svg' | asset_url }}"
    alt="{{ shop.name | escape }}"
    class="header__heading-logo motion-reduce solora-logo"
    width="{{ logo_width }}"
    height="{{ logo_width }}"
    loading="eager"
    fetchpriority="high"
  >
</div>
