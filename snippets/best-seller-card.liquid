{% comment %}
  Best Sellers Product Card Snippet
  Pulls 100% dynamic product data from Shopify Liquid (Product Object).
{% endcomment %}

{% liquid
  assign card_product = product
  assign aspect_ratio = media_aspect_ratio | default: 'portrait'
  
  if aspect_ratio == 'portrait'
    assign aspect_style = 'aspect-ratio: 1 / 1;'
  elsif aspect_ratio == 'square'
    assign aspect_style = 'aspect-ratio: 1 / 1;'
  else
    assign aspect_style = 'aspect-ratio: 1 / 1;'
  endif

  assign first_variant = card_product.selected_or_first_available_variant
  assign is_available = card_product.available

  if is_placeholder or card_product == blank
    assign is_placeholder = true
  else
    assign is_placeholder = false
  endif
%}

<div class="bs-card-item" data-product-id="{% if card_product %}{{ card_product.id }}{% else %}placeholder-{{ placeholder_index }}{% endif %}">
  <div class="bs-card bs-card--{{ card_style | default: 'elevated' }}">
    
    {% comment %} Media Container {% endcomment %}
    <div class="bs-card__media-container" style="{{ aspect_style }}">
      
      {% comment %} Badges Top-Left {% endcomment %}
      <div class="bs-card__badges">
        {% if show_badge %}
          <span class="bs-card__badge bs-card__badge--bestseller">
            <svg width="12" height="12" viewBox="0 0 24 24" fill="currentColor"><path d="M12 23c-6.075 0-11-4.925-11-11 0-4.045 2.193-7.58 5.46-9.522a.75.75 0 011.04.912C6.91 5.093 6.5 6.745 6.5 8.5c0 .324.017.644.05.959a10.96 10.96 0 014.283-4.305.75.75 0 011.08.761c-.32 1.947.16 3.93 1.34 5.443 1.18-1.513 1.66-3.496 1.34-5.443a.75.75 0 011.08-.761c1.82 1.155 3.25 2.68 4.133 4.455.15-.41.227-.85.227-1.31 0-1.755-.41-3.407-1.000-5.11a.75.75 0 011.04-.912C20.807 4.42 23 7.955 23 12c0 6.075-4.925 11-11 11z"/></svg>
            {{ badge_text | default: 'BEST SELLER' }}
          </span>
        {% endif %}

        {% if card_product and card_product.compare_at_price > card_product.price and card_product.available %}
          {% assign discount_perc = card_product.compare_at_price | minus: card_product.price | times: 100 | divided_by: card_product.compare_at_price | round %}
          <span class="bs-card__badge bs-card__badge--sale">
            -{{ discount_perc }}% OFF
          </span>
        {% elsif is_placeholder %}
          <span class="bs-card__badge bs-card__badge--sale">-20% OFF</span>
        {% endif %}
      </div>

      {% comment %} Action Buttons Top-Right {% endcomment %}
      <div class="bs-card__actions">
        <button type="button" class="bs-card__action-btn bs-card__action-btn--wishlist" aria-label="Add to wishlist" onclick="this.classList.toggle('is-active')">
          <svg class="icon-heart-empty" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path></svg>
          <svg class="icon-heart-filled" width="18" height="18" viewBox="0 0 24 24" fill="#FF4D6D" stroke="#FF4D6D" stroke-width="2"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path></svg>
        </button>
      </div>

      {% comment %} Main Link & Dynamic Images {% endcomment %}
      <a href="{% if card_product %}{{ card_product.url }}{% else %}#{% endif %}" class="bs-card__media-link">
        {% if card_product and card_product.featured_media %}
          <img
            src="{{ card_product.featured_media | image_url: width: 800 }}"
            srcset="{{ card_product.featured_media | image_url: width: 400 }} 400w, {{ card_product.featured_media | image_url: width: 800 }} 800w, {{ card_product.featured_media | image_url: width: 1200 }} 1200w"
            sizes="(min-width: 990px) 25vw, (min-width: 750px) 33vw, 50vw"
            alt="{{ card_product.featured_media.alt | escape | default: card_product.title }}"
            class="bs-card__img bs-card__img--primary"
            loading="lazy"
            width="{{ card_product.featured_media.width }}"
            height="{{ card_product.featured_media.height }}"
          >
          {% if show_secondary_image and card_product.media.size > 1 %}
            <img
              src="{{ card_product.media[1] | image_url: width: 800 }}"
              srcset="{{ card_product.media[1] | image_url: width: 400 }} 400w, {{ card_product.media[1] | image_url: width: 800 }} 800w"
              sizes="(min-width: 990px) 25vw, (min-width: 750px) 33vw, 50vw"
              alt="{{ card_product.media[1].alt | escape | default: card_product.title }}"
              class="bs-card__img bs-card__img--secondary"
              loading="lazy"
              width="{{ card_product.media[1].width }}"
              height="{{ card_product.media[1].height }}"
            >
          {% endif %}
        {% else %}
          {% comment %} Fallback for empty Shopify store preview {% endcomment %}
          {% assign placeholder_num = placeholder_index | default: 1 %}
          {% if placeholder_num == 1 %}
            <img src="{{ 'dr-melaxin-hero-full-5pcs.png' | asset_url }}" class="bs-card__img bs-card__img--primary" alt="Product Image" loading="lazy" width="800" height="1000">
          {% elsif placeholder_num == 2 %}
            <img src="{{ 'solora-collagen-boost-hero.png' | asset_url }}" class="bs-card__img bs-card__img--primary" alt="Product Image" loading="lazy" width="800" height="1000">
          {% elsif placeholder_num == 3 %}
            <img src="{{ 'solora-hero-desktop.png' | asset_url }}" class="bs-card__img bs-card__img--primary" alt="Product Image" loading="lazy" width="800" height="1000">
          {% else %}
            <img src="{{ 'solora-theme-dr-melaxin-hero.png' | asset_url }}" class="bs-card__img bs-card__img--primary" alt="Product Image" loading="lazy" width="800" height="1000">
          {% endif %}
        {% endif %}
      </a>

      {% comment %} Quick Add Slide-Up Bar {% endcomment %}
      {% if show_quick_add %}
        <div class="bs-card__quick-add-bar">
          {% if is_available %}
            {% if card_product and card_product.has_only_default_variant %}
              <button
                type="button"
                class="bs-card__quick-btn js-bs-quick-add"
                data-variant-id="{{ first_variant.id }}"
              >
                <span class="bs-btn-text">+ Quick Add</span>
                <span class="bs-btn-spinner hidden"></span>
              </button>
            {% elsif card_product %}
              <a href="{{ card_product.url }}" class="bs-card__quick-btn">
                <span>Select Options</span>
              </a>
            {% else %}
              <button
                type="button"
                class="bs-card__quick-btn js-bs-quick-add-demo"
              >
                <span class="bs-btn-text">+ Quick Add</span>
                <span class="bs-btn-spinner hidden"></span>
              </button>
            {% endif %}
          {% else %}
            <button type="button" class="bs-card__quick-btn" disabled>Sold Out</button>
          {% endif %}
        </div>
      {% endif %}

    </div>

    {% comment %} Card Content Details {% endcomment %}
    <div class="bs-card__content">
      <div class="bs-card__top-info">
        {% comment %} Vendor / Brand {% endcomment %}
        {% if show_vendor %}
          <div class="bs-card__vendor">
            {% if card_product and card_product.vendor != blank %}
              {{ card_product.vendor | upcase }}
            {% else %}
              SOLLORA
            {% endif %}
          </div>
        {% endif %}

        {% comment %} Title {% endcomment %}
        <h3 class="bs-card__title">
          <a href="{% if card_product %}{{ card_product.url }}{% else %}#{% endif %}">
            {% if card_product and card_product.title != blank %}
              {{ card_product.title }}
            {% else %}
              {% if placeholder_num == 1 %}Hydro-Glow Serum Supreme{% elsif placeholder_num == 2 %}Microcurrent Massager Pro{% elsif placeholder_num == 3 %}VelvetTouch™ IPL Hair Removal{% else %}ClearVision™ Oil Film Remover{% endif %}
            {% endif %}
          </a>
        </h3>

        {% comment %} Rating Stars {% endcomment %}
        {% if show_rating %}
          <div class="bs-card__rating">
            <div class="bs-stars" aria-label="5 out of 5 stars">
              ★★★★★
            </div>
            <span class="bs-rating-count">
              {% if card_product and card_product.metafields.reviews.rating.value %}
                {{ card_product.metafields.reviews.rating.value | round: 1 }} ({{ card_product.metafields.reviews.rating_count.value | default: '24' }})
              {% elsif card_product and card_product.metafields.loox.avg_rating %}
                {{ card_product.metafields.loox.avg_rating }} ({{ card_product.metafields.loox.num_reviews | default: '18' }})
              {% else %}
                5.0 ({% cycle '124', '89', '210', '156' %})
              {% endif %}
            </span>
          </div>
        {% endif %}


      </div>

      {% comment %} Pricing Row & Buy Button (100% Dynamic Shopify Price formatting) {% endcomment %}
      <div class="bs-card__footer">
        <div class="bs-card__price-wrapper">
          {% if card_product %}
            <span class="bs-card__price bs-card__price--sale">
              {{ card_product.price | money }}
            </span>
            {% if card_product.compare_at_price > card_product.price %}
              <span class="bs-card__price bs-card__price--regular">
                {{ card_product.compare_at_price | money }}
              </span>
            {% endif %}
          {% else %}
            <span class="bs-card__price bs-card__price--sale">$49.00</span>
            <span class="bs-card__price bs-card__price--regular">$65.00</span>
          {% endif %}
        </div>

        {% comment %} Direct Add to Cart Icon Button {% endcomment %}
        <button
          type="button"
          class="bs-card__atc-icon-btn js-bs-quick-add{% if card_product and card_product.has_only_default_variant == false %}-nav{% endif %}"
          {% if card_product and card_product.has_only_default_variant %}
            data-variant-id="{{ first_variant.id }}"
          {% elsif card_product %}
            onclick="window.location.href='{{ card_product.url }}'"
          {% endif %}
          aria-label="Add to Cart"
        >
          <svg class="bs-atc-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"></path><line x1="3" y1="6" x2="21" y2="6"></line><path d="M16 10a4 4 0 0 1-8 0"></path></svg>
          <svg class="bs-check-icon hidden" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#2e7d32" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>
        </button>
      </div>

    </div>

  </div>
</div>
